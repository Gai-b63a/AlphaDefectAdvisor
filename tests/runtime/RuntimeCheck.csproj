<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(VmProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);VM_PROBE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../advisor/AdvisorText.cs" />
    <Compile Include="../../advisor/RunClearHistory.cs" />
    <EmbeddedResource Include="../../advisor/locales/*.json" LogicalName="AdvisorText.%(Filename).json" />
  </ItemGroup>
  <ItemGroup Condition="'$(VmProbe)' == 'true'">
    <Compile Include="../../advisor/AdvisorRuntime.cs" />
  </ItemGroup>
</Project>
